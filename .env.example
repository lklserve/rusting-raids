# ============================================================================
# Variáveis de ambiente do Rusting Raids.
# Este arquivo é só um MODELO (pode ir para o git). Os valores de verdade ficam
# nas VARIÁVEIS DE AMBIENTE da Vercel (Project → Settings → Environment Variables),
# NUNCA aqui e NUNCA no código.
# ============================================================================

# --- Supabase (projeto DEDICADO ao jogo) ---
# Project Settings → Data API / API Keys
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# A service_role NUNCA vai para o navegador. Só as funções da Vercel a usam.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago ---
# Suas credenciais → Access Token de PRODUÇÃO (começa com APP_USR-...)
MERCADO_PAGO_ACCESS_TOKEN=
# Opcional: segredo do webhook (Webhooks → configurar) para conferir a assinatura.
MERCADO_PAGO_WEBHOOK_SECRET=

# --- Site ---
# Endereço público do site (para montar a URL do webhook). Ex.: https://rusting-raids.vercel.app
SITE_URL=https://rusting-raids.vercel.app
# Trave o CORS na origem do site (recomendado). Deixe em branco só em teste.
SITE_ORIGEM=https://rusting-raids.vercel.app

# --- Conta Google e save na nuvem (supabase/contas.sql, api/conta/[acao].js) ---
# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth do tipo "Aplicativo da Web".
# É o mesmo valor que o jogo usa como serverClientId (Game.Core/Licenca/EntrarComGoogle.cs). Não é segredo.
# Vários separados por vírgula, se precisar trocar de cliente.
GOOGLE_CLIENT_ID=
# Segredo que assina a sessão (JWT HS256) que o jogo guarda. Mínimo 32 bytes, aleatório. Trocar derruba todas as sessões.
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
